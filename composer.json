{
    "name": "timatic/timatic-api",
    "description": "API backend for Timatic",
    "type": "project",
    "license": "ELv2",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "azuyalabs/yasumi": "^2.5",
        "bezhansalleh/filament-shield": "^4.2",
        "brick/math": "^0.12",
        "dedoc/scramble": "^0.13.10",
        "dedoc/scramble-pro": "^0.8.4",
        "doctrine/dbal": "^3.5",
        "fedeisas/laravel-mail-css-inliner": "^5.4",
        "filament/filament": "^5.0",
        "firebase/php-jwt": "^7.0",
        "guzzlehttp/guzzle": "^7.8",
        "laravel/framework": "^12.8",
        "laravel/socialite": "^5.19",
        "laravel/tinker": "^2.10.1",
        "league/flysystem": "^3.29",
        "league/flysystem-aws-s3-v3": "^3.29",
        "openspout/openspout": "^4.28",
        "promphp/prometheus_client_php": "^2.6",
        "saloonphp/laravel-plugin": "^4.0",
        "saloonphp/pagination-plugin": "^2.3",
        "sentry/sentry-laravel": "^4.15",
        "socialiteproviders/auth0": "^4.2",
        "socialiteproviders/google": "^4.1",
        "socialiteproviders/microsoft-azure": "^5.2",
        "spatie/laravel-json-api-paginate": "^1.16",
        "spatie/laravel-permission": "^6.17",
        "spatie/laravel-query-builder": "^6.3",
        "timacdonald/json-api": "dev-main as 1.0.0-beta.99",
        "timatic/bitbucket-integration": "1.0.0",
        "timatic/google-calendar-integration": "1.0.0",
        "timatic/jira-integration": "1.0.0",
        "timatic/nmbrs-integration": "*",
        "timatic/rework-integration": "^1.0",
        "timatic/topdesk-integration": "1.0.0",
        "webmozart/assert": "^2.1",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.1",
        "laravel-shift/blueprint": "*",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "integrations/jira"
        },
        {
            "type": "path",
            "url": "integrations/bitbucket"
        },
        {
            "type": "path",
            "url": "integrations/google-calendar"
        },
        {
            "type": "path",
            "url": "integrations/nmbrs"
        },
        {
            "type": "path",
            "url": "integrations/rework"
        },
        {
            "type": "path",
            "url": "integrations/topdesk"
        },
        {
            "type": "vcs",
            "url": "https://github.com/timatic/json-api"
        },
        {
            "type": "composer",
            "url": "https://satis.dedoc.co"
        }
    ],
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ],
            "ignore-duplicates": false,
            "recurse": false,
            "replace": false,
            "merge-dev": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "lint": "vendor/bin/pint -v --test --ansi",
        "fix": "vendor/bin/pint -v --ansi",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=-1 --ansi",
        "test": "vendor/bin/pest --colors=always",
        "prepare-commit": [
            "@fix",
            "@analyse",
            "@test"
        ],
        "ci:lint": "@lint --format=junit",
        "ci:analyse": "@analyse --no-progress --error-format=gitlab --no-interaction",
        "ci:test": "vendor/bin/pest --do-not-cache-result --coverage-text=coverage.txt --log-junit phpunit-report.xml --colors=never",
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ]
    }
}
