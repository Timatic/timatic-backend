{
    "name": "timatic/topdesk-integration",
    "description": "TOPdesk ticket provider integration for Timatic",
    "type": "library",
    "version": "1.0.0",
    "require": {
        "php": "^8.4",
        "saloonphp/saloon": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Timatic\\Topdesk\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Timatic\\Topdesk\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
