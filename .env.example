APP_NAME=timatic-api
APP_ENV=local
APP_KEY=
APP_DEBUG=true
TENANT_NAME="Company XYZ"
TENANT_SLUG=app
APP_URL="https://api.${TENANT_SLUG}.timatic.test"
ADMIN_URL="https://admin.${TENANT_SLUG}.timatic.test"
AUTH_PROXY_URL=https://auth.timatic.app
APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_VERSION=0.0.0

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

APP_FRONTEND_URL=https://tenant.timatic.test

LOG_CHANNEL=stack
LOG_STACK=single

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=timatic
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=redis
QUEUE_CONNECTION=sync

SESSION_DRIVER=database
SESSION_DOMAIN=.timatic.test
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
SESSION_LIFETIME="720" # 24 hours

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=noreply@timatic.app
MAIL_FROM_NAME="${APP_NAME}"

BUDGET_USAGE_EMAIL_CC=someone@timatic.app

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT=
AWS_DEFAULT_REGION=nl
AWS_BUCKET=

FILESYSTEM_DISK=local

SOCIALITE_DRIVER=azure # azure | auth0 | google

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI="${APP_URL}/auth/callback"
AZURE_TENANT_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/callback"

SCRAMBLE_ALLOW_ACCESS=false

JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
